<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <flow-layout direction="vertical" id="root">
                    <children/>

                    <sizing>
                        <horizontal method="content">0</horizontal>
                        <vertical method="content">0</vertical>
                    </sizing>
                    <positioning type="relative">100,0</positioning>

                    <horizontal-alignment>right</horizontal-alignment>

                    <padding><all>2</all></padding>
                    <margins><all>2</all></margins>
                    <gap>2</gap>
                </flow-layout>
            </children>
        </flow-layout>
    </components>
    <templates>
        <template name="survivor_entry">
            <flow-layout direction="horizontal">
                <children>
                    <flow-layout direction="vertical" id="text_block">
                        <children>
                            <label>
                                <text>{{display_name}}</text>
                                <sizing>
                                    <vertical method="fixed">8</vertical>
                                </sizing>
                            </label>
                            <label id="effects_line">
                                <color>light-purple</color>
                                <sizing>
                                    <vertical method="fixed">8</vertical>
                                </sizing>
                            </label>
                        </children>

                        <horizontal-alignment>right</horizontal-alignment>
                        <gap>1</gap>
                        <padding>
                            <horizontal>2</horizontal>
                        </padding>
                    </flow-layout>
                    <stack-layout id="skin_icon_container">
                        <children>
                            <texture
                                    texture="fearsome:textures/ui/survivor_list.png"
                                    u="0" v="12"
                                    region-width="12" region-height="12"
                                    texture-width="256" texture-height="256"
                            >
                                <sizing>
                                    <vertical method="fill">100</vertical>
                                    <horizontal method="fill">100</horizontal>
                                </sizing>
                            </texture>
                        </children>
                    </stack-layout>
                    <fearsome.linear_bar is-vertical="true" id="death_timer">
                        <is-vertical>true</is-vertical>
                        <background-color>#FF3C3C3C</background-color>

                        <sizing>
                            <horizontal method="fixed">2</horizontal>
                            <vertical method="fill">100</vertical>
                        </sizing>

                        <margins><left>2</left></margins>
                    </fearsome.linear_bar>
                </children>

                <vertical-alignment>top</vertical-alignment>

                <sizing>
                    <horizontal method="content">0</horizontal>
                    <vertical method="content">0</vertical>
                </sizing>
            </flow-layout>
        </template>
    </templates>
</owo-ui>