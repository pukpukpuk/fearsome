    ///

    "fearsome.character.{}": {
        "survivors.{}": {
            "mechanic.{}": {
                "name": "Джон Хоффман",
                "short_name": "Джон",
                "ability.{}": {
                    "name": "Гаечный ключ",
                    "description": "Количество зарядов - 1. Посмотрите на генератор и нажмите {key_first_ability}, чтобы мгновенно починить {amount}% прогресса генератора. Раз в 60 секунд с начала матча количество прогресса, которое чинит предмет, увеличивается на 1%. Заряды не восполняются",
                    "specificities.{}": [
                        "Предмет можно использовать на разряженный генератор",
                        "Прогресс, который чинит предмет, тратит очки аккуратности так же, как обычная починка",
                        "Жетоны навыка «Техник» добавляются к прогрессу, который чинит предмет"
                    ]
                },
                "passive.{}": {
                    "name": "Мастерство",
                    "description": "Скорость вашей починки увеличивается на {percent}% за каждый другой генератор, который вы чинили менее {window, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}} назад"
                }
            },
            "nurse.{}": {
                "name": "Агнес Виолет",
                "short_name": "Агнес",
                "ability.{}": {
                    "name": "Аптечка",
                    "description": "Шкала аптечки - {capacity} ❤. <control_keys>Присядьте</control_keys> и удерживайте {key_first_ability}, чтобы лечить себя. Во время самолечения вы восстанавливаете 1 ❤ за {period, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}} и не можете лечить других выживших и получать лечение от них. Самолечение тратит {ratio} ❤ шкалы аптечки за каждое восстановленное ❤. Удерживайте {key_second_ability} во время лечения другого выжившего, чтобы скорость вашего лечения увеличилась на {bonus}%. Такое лечение тратит 1 ❤ шкалы аптечки за каждое восстановленное ❤. Шкала аптечки не восполняется",
                    "specificities.{}": [
                        "В предсмертном состоянии для самолечения не нужно приседать"
                    ]
                },
                "passive.{}": {
                    "name": "Быстрое заживление",
                    "description": "Если вы лечите выжившего в раненом состоянии в одиночку, скорость вашего лечения увеличивается на {percent}%"
                }
            },
            "addict.{}": {
                "name": "Бобби Венстоун",
                "short_name": "Бобби",
                "ability.{}": {
                    "name": "Шприц",
                    "description": "Количество зарядов - 1. Нажмите {key_first_ability}, чтобы получить эффект <effect>Скорость {level}</effect> на {duration, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}}. При использовании скорость вашей ходьбы возвращается к {speed}, а её уменьшение от пассивной способности начинается заново. Заряды не восполняются",
                    "specificities.{}": [
                        "Если у вас уже есть эффект <effect>Скорость</effect>, уровень нового эффекта увеличивается на уровень текущего"
                    ]
                },
                "passive.{}": {
                    "name": "Зависимость",
                    "description": "Скорость вашей ходьбы уменьшается на {reduce} раз в {period, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}}. Минимальная скорость ходьбы - {min_speed}"
                }
            },
            "nun.{}": {
                "name": "Роза Франк",
                "short_name": "Роза",
                "ability.{}": {
                    "name": "Осколки стекла",
                    "description": "Количество зарядов - {charges}. Удерживайте {key_first_ability} в течение {hold, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}, чтобы телепортироваться в шкаф, самый дальний от маньяка. Во время удержания скорость вашей ходьбы уменьшается до {speed}, вы получаете эффект <effect>Слепота</effect> и не можете прыгать и бежать. При телепортации вы теряете {damage} ❤. Заряды не восполняются. Перезарядка - {cooldown, plural, one{# секунда} few{# секунды} many{# секунд} other{# секунды}}",
                    "specificities.{}": [
                        "Потеря ❤ может перевести вас в раненое или предсмертное состояние"
                    ]
                },
                "passive.{}": {
                    "name": "Помощь свыше",
                    "description": "Количество квестов на карте увеличивается на {quests}"
                }
            },
            "buterenko.{}": {
                "name": "Александр Бутеренко",
                "short_name": "Александр",
                "ability.{}": {
                    "name": "Манекен",
                    "description": "Нажмите {key_first_ability}, чтобы начать запись ваших действий на {record, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}}. Повторное нажатие {key_first_ability} или получение урона отменяет запись. По окончании записи манекен повторяет записанные действия по кругу в течение {play, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}. Манекен разрушается по окончании этого времени, при ударе маньяка или при вашем ударе с расстояния менее {destroy_distance, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}}. После разрушения на месте манекена остаётся предмет. Подойдите к предмету на расстояние менее {pickup_distance, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}}, чтобы подобрать его и снова использовать способность. Если вы не подбираете предмет в течение {lifetime, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}, он пропадает",
                    "specificities.{}": [
                        "Если вы разрушаете манекен ударом с расстояния менее {destroy_distance, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}}, предмет мгновенно возвращается к вам",
                        "Манекен не может иметь статусов",
                        "Изменения скорости выполнения действий не влияют на манекен",
                        "Навыки не действуют на манекен",
                        "Манекен не оставляет следов и не подсвечивается маньяку"
                    ]
                },
                "passive.{}": {
                    "name": "Поддержка",
                    "description": "Если количество других выживших в радиусе {radius, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}} от вас не менее 1, скорость вашей починки увеличивается на {percent}% и вы получаете эффект <effect>Скорость {level}</effect>",
                    "specificities.{}": [
                        "Манекен также активирует бонус"
                    ]
                }
            }
        },
        "murderers.{}": {
            "ghost.{}": {
                "name": "Призрак",
                "short_name": "Призрак",
                "ability.{}": {
                    "name": "Колокол",
                    "description": "Нажмите {key_first_ability}, чтобы перейти в состояние спектрала. В состоянии спектрала вы получаете статус <term>Невидимость</term>, скорость вашей ходьбы увеличивается до {spectral_speed}, а вы не можете атаковать. Выжившие не чувствуют ваш радиус террора, пока вы находитесь в состоянии спектрала. Удерживайте {key_first_ability} в течение {hold, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}, чтобы выйти из состояния спектрала. Во время удержания вы становитесь видимым и издаёте звон колокола, скорость вашей ходьбы уменьшается до {holding_speed}, и вы не можете прыгать и бежать. После выхода скорость вашей ходьбы остаётся {spectral_speed} в течение {speed_reset_delay, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}. Перезарядка - {cooldown, plural, one{# секунда} few{# секунды} many{# секунд} other{# секунды}}",
                    "specificities.{}": [
                        "Во время удержания {key_first_ability} видимость и радиус террора восстанавливаются пропорционально времени удержания",
                        "Если удержание {key_first_ability} длится менее {hold, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}, вы снова получаете статус <term>Невидимость</term>",
                        "Пока вы ломаете дверь или генератор в состоянии спектрала, вы становитесь видимым на {breaking_visibility}%"
                    ]
                },
                "passive.{}": {
                    "name": "Клочок хитона",
                    "description": "Количество квестов на карте увеличивается на {quests}. Дополнительно на карте появляются призрачные квесты, их количество - {fake_quests}. Использование призрачного квеста не уменьшает количество квестов, которые нужно использовать для зарядки генераторов"
                }
            },
            "mercenary.{}": {
                "name": "Наёмник",
                "short_name": "Наёмник",
                "ability.{}": {
                    "name": "Склянка с ядом",
                    "description": "Количество зарядов - {charges}. Нажмите {key_first_ability}, чтобы бросить склянку. При броске количество зарядов уменьшается на 1. При столкновении склянка разбивается и оставляет ядовитое облако на {cloud_lifetime, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}}. Выживший в облаке подсвечивается вам, получает эффекты <effect>Слепота</effect>, <effect>Тошнота</effect> и <effect>Замедление {slowness_level}</effect> и не может прыгать и бежать. Эффекты, ограничения и подсветка действуют, пока выживший находится в облаке, и в течение {effects_duration, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}} после выхода из него. Если вы находитесь в облаке более {scan_time, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}, все выжившие в радиусе {scan_radius, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}} от вас подсвечиваются вам. Подсветка действует, пока вы находитесь в облаке, и в течение 1 секунды после выхода из него. Удерживайте {key_second_ability} в течение {reload, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}, чтобы восполнить все заряды. Во время удержания скорость вашей ходьбы уменьшается до {reload_speed}, и вы не можете прыгать, бежать и бросать склянки",
                    "specificities.{}": [
                        "Удержание {key_second_ability} доступно, только если количество зарядов менее {charges}",
                        "Если удержание {key_second_ability} длится менее {reload, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}, заряды не восполняются",
                        "Выживший, в которого попадает склянка, мгновенно получает эффекты облака",
                        "Облако увеличивается, если склянка разбивается на расстоянии более {growth_distance, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}} от вас, и достигает максимального размера на расстоянии {max_growth_distance, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}}",
                        "После получения удара от вас выживший теряет эффекты облака и в течение {immunity, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}} не может получить их повторно"
                    ]
                },
                "passive.{}": {
                    "name": "Ампула с замедлением",
                    "description": "При починке генератора или использовании квеста выживший получает эффект <effect>Замедление {level}</effect> на {duration, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}}",
                    "specificities.{}": [
                        "Во время починки длительность эффекта обновляется при каждом 1% прогресса генератора"
                    ]
                }
            },
            "artist.{}": {
                "name": "Художница",
                "short_name": "Художница",
                "ability.{}": {
                    "name": "Рокировка",
                    "description": "Удерживайте {key_first_ability} не менее {min_hold, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}, чтобы создать связь с ближайшим дееспособным выжившим в радиусе {radius, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}} от вас. Во время удержания вы получаете эффект <effect>Замедление V</effect>. При создании связи связанный выживший получает статус <term>Связь</term> и подсвечивается вам на {glow_duration, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}}. Время починки связанного выжившего увеличивается на {percent}%, а скорость его лечения других выживших уменьшается на {percent}%. Нажмите {key_first_ability}, чтобы поменяться местами со связанным выжившим. После обмена связь пропадает",
                    "specificities.{}": [
                        "Пока вы удерживаете {key_first_ability}, связь переходит к ближайшему подходящему выжившему",
                        "Связь пропадает, если связанный выживший переходит в предсмертное состояние"
                    ]
                },
                "passive.{}": {
                    "name": "Окровавленный холст",
                    "description": "При разрядке генераторов все квесты на карте подсвечиваются вам на {glow_duration, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}}",
                    "specificities.{}": [
                        "Подсветка квеста пропадает при его использовании или при зарядке генераторов"
                    ]
                }
            },
            "dream.{}": {
                "name": "Видение",
                "short_name": "Видение",
                "ability.{}": {
                    "name": "Засыпание",
                    "description": "Выжившие вне мира снов вас не видят, а ваши удары по ним не наносят урона. Ударьте выжившего вне мира снов, чтобы он начал засыпать. Через {falling_asleep, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}} выживший переходит в мир снов, а на его месте появляется неактивный портал. Через {charge, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}} портал становится активным. Выживший в мире снов видит вас, чувствует ваш радиус террора и получает эффект <effect>Тьма</effect>, а время его починки увеличивается на {debuff}%. Ваши удары по выжившему в мире снов наносят урон. После усыпляющего удара вы получаете эффект <effect>Замедление III</effect> и не можете прыгать в течение {falling_asleep, plural, one{# секунды} few{# секунд} many{# секунд} other{# секунды}}. Перезарядка - {cooldown, plural, one{# секунда} few{# секунды} many{# секунд} other{# секунды}}",
                    "specificities.{}": [
                        "Выживший, который проходит через активный портал, переходит в мир снов или выходит из него, а портал становится неактивным на {charge, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}}",
                        "Выживший выходит из мира снов при переходе в предсмертное состояние",
                        "Пока выживший засыпает, он получает эффект <effect>Тошнота</effect> и начинает видеть вас",
                        "Порталы в радиусе {portals_glow_radius, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}} от выжившего подсвечиваются ему",
                        "Если в радиусе {min_portal_distance, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}} от выжившего есть другой портал, новый портал появляется, только когда выживший выходит из этого радиуса",
                        "Максимальное количество порталов на карте - {max_portals}",
                        "Если количество порталов превышает максимальное, самый старый портал пропадает",
                        "Выжившие вне мира снов чувствуют ваш радиус террора только в радиусе {awake_terror_radius, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}} от вас"
                    ]
                },
                "ability2.{}": {
                    "name": "Гипнический рывок",
                    "description": "Посмотрите на портал и нажмите {key_second_ability}, чтобы начать наблюдение через него. Во время наблюдения вы не можете двигаться, атаковать и взаимодействовать с картой. Если портал активен, нажмите {key_third_ability}, чтобы через {emerge, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}} появиться из него. Появление делает портал неактивным на {charge, plural, one{# секунду} few{# секунды} many{# секунд} other{# секунды}}. Посмотрите на другой портал и нажмите {key_second_ability}, чтобы переключиться на него. <control_keys>Присядьте</control_keys>, чтобы вернуться на исходную позицию",
                    "specificities.{}": [
                        "Переключение на другой портал и возвращение на исходную позицию отменяют появление"
                    ]
                },
                "passive.{}": {
                    "name": "Таинственное присутствие",
                    "description": "Время починки у выживших в радиусе {radius, plural, one{# блока} few{# блоков} many{# блоков} other{# блока}} от вас увеличивается на {percent}%, а скорость их лечения других выживших уменьшается на {percent}%"
                }
            }
        }
    },
