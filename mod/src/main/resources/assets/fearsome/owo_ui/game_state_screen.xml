<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <flow-layout direction="horizontal">
                    <children>
                        <stack-layout id="minimap_root">
                            <children>
                                <box>
                                    <color>#FF000000</color>
                                    <fill>true</fill>
                                    <sizing>
                                        <vertical method="fill">100</vertical>
                                        <horizontal method="fill">100</horizontal>
                                    </sizing>
                                </box>
                                <label>
                                    <text>карта</text>
                                </label>
                            </children>
                            <sizing>
                                <horizontal method="fixed">48</horizontal>
                                <vertical method="fixed">48</vertical>
                            </sizing>
                        </stack-layout>
                        <flow-layout direction="horizontal" id="abilities_root">
                            <children/>
                            <gap>4</gap>
                            <allow-overflow>true</allow-overflow>
                        </flow-layout>
                        <flow-layout direction="vertical" id="game_tools_root">
                            <children>
                                <fearsome.with_binding_stack_layout binding_id="open_builds_browser">
                                    <children>
                                        <fearsome.colorable_texture
                                                texture="fearsome:textures/ui/icons/builds_browser.png"
                                                side_length="16"
                                                id="builds_browser_icon">
                                        </fearsome.colorable_texture>
                                    </children>
                                </fearsome.with_binding_stack_layout>
                                <fearsome.with_binding_stack_layout binding_id="highlight_generators" >
                                    <children>
                                        <fearsome.tiled_texture
                                                texture="fearsome:textures/ui/icons/generator_highlighter.png"
                                                side_length="16"
                                                texture_width="32" texture_height="16"
                                                id="generator_highlighter_icon">
                                        </fearsome.tiled_texture>
                                    </children>
                                </fearsome.with_binding_stack_layout>
                            </children>
                            <gap>2</gap>
                            <allow-overflow>true</allow-overflow>
                        </flow-layout>
                    </children>
                    <gap>2</gap>
                </flow-layout>
                <flow-layout direction="vertical" id="global_info_root">
                    <children>
<!--                        first line-->
                        <flow-layout direction="horizontal">
                            <children>
                                <texture texture="fearsome:textures/ui/icons/hourglass.png"
                                         u="0" v="0"
                                         region-width="7" region-height="7"
                                         texture-width="7" texture-height="7"
                                >
                                </texture>
                                <label id="until_end_timer">
                                    <text>00:00</text>
                                    <sizing>
                                        <vertical method="fixed">7</vertical>
                                    </sizing>
                                </label>
                            </children>
                            <gap>2</gap>
                        </flow-layout>

<!--                        second line-->
                        <flow-layout direction="horizontal">
                            <children>
<!--                                generators part-->
                                <flow-layout direction="horizontal">
                                    <children>
                                        <texture texture="fearsome:textures/ui/icons/generator.png"
                                                 u="0" v="0"
                                                 region-width="7" region-height="7"
                                                 texture-width="7" texture-height="7"
                                        >
                                        </texture>
                                        <label id="generators_count">
                                            <text>0/0</text>
                                            <sizing>
                                                <vertical method="fixed">7</vertical>
                                            </sizing>
                                        </label>
                                    </children>
                                    <gap>2</gap>
                                </flow-layout>

<!--                                quests part-->
                                <flow-layout direction="horizontal">
                                    <children>
                                        <fearsome.colorable_texture
                                                texture="fearsome:textures/ui/icons/quest.png"
                                                side_length="7"
                                                id="quests_icon">
                                        </fearsome.colorable_texture>
                                        <label id="quests_count">
                                            <text>0</text>
                                            <sizing>
                                                <vertical method="fixed">7</vertical>
                                            </sizing>
                                        </label>
                                    </children>
                                    <gap>2</gap>
                                </flow-layout>
                            </children>
                            <gap>6</gap>
                        </flow-layout>


<!--                        effects table-->
                        <grid-layout rows="1" columns="2">
                            <children>
                                <flow-layout direction="vertical" row="0" column="0" id="effect_name_column">
                                    <children/>
                                </flow-layout>
                                <flow-layout direction="vertical" row="0" column="1" id="effect_time_column">
                                    <children/>
                                    <margins><left>4</left></margins>
                                    <horizontal-alignment>right</horizontal-alignment>
                                </flow-layout>
                            </children>
                            <surface>
                                <flat>#55101010</flat>
                            </surface>
                            <padding>
                                <all>2</all>
                                <bottom>1</bottom>
                            </padding>
                        </grid-layout>
                    </children>
                    <gap>2</gap>
                </flow-layout>
            </children>

            <padding><all>6</all></padding>
            <gap>2</gap>
        </flow-layout>
    </components>
    <templates>
        <template name="ability_card">
            <stack-layout>
                <children>
                    <fearsome.radial_bar id="bar">
                        <border-width>2</border-width>
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="fill">100</vertical>
                        </sizing>
                    </fearsome.radial_bar>
                    <fearsome.hideable_stack_layout id="ability_count_root">
                        <children>
                            <label id="ability_count">
                                <text>1</text>
                                <horizontal-text-alignment>right</horizontal-text-alignment>
                                <sizing><vertical method="fixed">8</vertical></sizing>
                            </label>
                        </children>
                        <padding>
                            <all>1</all>
                            <left>2</left>
                        </padding>
                        <horizontal-alignment>right</horizontal-alignment>
                        <positioning type="relative">100,100</positioning>
                    </fearsome.hideable_stack_layout>
                </children>
                <sizing>
                    <horizontal method="fixed">34</horizontal>
                    <vertical method="fixed">34</vertical>
                </sizing>
                <allow-overflow>true</allow-overflow>
            </stack-layout>
        </template>
    </templates>
</owo-ui>