<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="vertical">
            <children>
                <flow-layout direction="vertical" id="root">
                    <children>
                        <flow-layout direction="horizontal">
                            <children>
                                <texture texture="fearsome:textures/ui/icons/players.png"
                                         u="0" v="0"
                                         region-width="7" region-height="7"
                                         texture-width="7" texture-height="7"
                                />
                                <label><text translate="true">fearsome.ui.lobby.player_count</text></label>
                                <label id="player_count_label"><text>123</text></label>
                            </children>
                            <gap>2</gap>
                            <sizing><vertical method="fixed">8</vertical></sizing>
                        </flow-layout>

                        <flow-layout direction="horizontal">
                            <children>
                                <texture texture="fearsome:textures/ui/icons/queue_players.png"
                                         u="0" v="0"
                                         region-width="7" region-height="7"
                                         texture-width="7" texture-height="7"
                                />
                                <label><text translate="true">fearsome.ui.lobby.in_queue_count</text></label>
                                <label id="in_queue_count_label"><text>69</text></label>
                            </children>
                            <gap>2</gap>
                            <sizing><vertical method="fixed">8</vertical></sizing>
                        </flow-layout>

                        <flow-layout direction="horizontal" id="timer_line">
                            <children>
                                <texture texture="fearsome:textures/ui/icons/hourglass.png"
                                         u="0" v="0"
                                         region-width="7" region-height="7"
                                         texture-width="7" texture-height="7"
                                />
                                <label><text translate="true">fearsome.ui.lobby.until_start</text></label>
                                <label id="timer_label"><text>00:00</text></label>
                            </children>
                            <gap>2</gap>
                            <sizing><vertical method="fixed">8</vertical></sizing>
                        </flow-layout>
                    </children>

                    <gap>2</gap>

                    <vertical-alignment>top</vertical-alignment>
                    <margins><all>4</all></margins>
                </flow-layout>
            </children>
        </flow-layout>
    </components>
</owo-ui>