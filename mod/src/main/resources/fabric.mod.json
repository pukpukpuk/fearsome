{
    "schemaVersion": 1,
    "id": "fearsome",
    "version": "${version}",
    "environment": "client",
    "entrypoints": {
        "client": [
            "one.autremel.fearsome.FearsomeMod"
        ]
    },
    "mixins": [
        "fearsome.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "owo-lib": "${owo_version}"
    },

    "name": "Fearsome",
    "icon": "icon.png",
    "authors": ["pukpukpuk"],
    "description": "A required client-side mod for Fear: GOTY Edition",
    "license": "MIT",
    "contact": {
        "homepage": "https://www.youtube.com/watch?v=PkT0PJwy8mI",
        "issues": "https://github.com/pukpukpuk/fearsome/issues"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/trmFnBRUGg",
                "modmenu.github_releases": "https://github.com/pukpukpuk/fearsome/releases",
                "modmenu.source": "https://github.com/pukpukpuk/fearsome"
            },
            "update_checker": false
        }
    }

}
